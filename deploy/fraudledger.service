[Unit]
Description=Fraud Ledger review UI
After=network.target

[Service]
Type=simple
User=fraudledger
Group=fraudledger
Environment=FRAUDLEDGER_CONFIG=/etc/fraudledger/config.yaml
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/fraudledger
Environment=XDG_CACHE_HOME=/var/lib/fraudledger/tmp
ExecStart=/opt/fraudledger/venv/bin/fraudledger serve
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/fraudledger /var/log/fraudledger

[Install]
WantedBy=multi-user.target
